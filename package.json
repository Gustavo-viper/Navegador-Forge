{
  "name": "forge-browser",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/performance-optimize.cjs && vite",
    "build:web": "vite build",
    "prepare:icon": "node scripts/prepare-icon.cjs",
    "optimize": "node scripts/performance-optimize.cjs",
    "build": "npm run optimize && npm run build:web && npm run prepare:icon && electron-builder --win nsis --x64 --publish never",
    "start": "vite preview --host 0.0.0.0 --port $PORT",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "2.1.1",
    "electron-updater": "^6.6.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.52.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
